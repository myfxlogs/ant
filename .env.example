# Ant runtime env examples
#
# ENV-TO-PG-1 分档（ADR-0031）：env 只留「连库之前的引导件」（A）与「构建/部署期变量」（B）。
# 业务旋钮（C）与秘密件（D）唯一真相源=PG（system_config / platform_secrets）：
#   首次 boot 时 env 非空值自动 seed 入库（仅缺键种入），此后 DB 权威、env 改值失效；
#   已部署环境可从 .env 删除 C/D 键（行为不变），新键/改值走管理面 SystemConfig。
#   门禁：scripts/check-env-reads.sh（引导件外禁 env 直读，pre-commit 强制）。
#
# Usage:
#   cp .env.example .env
#   # then fill REQUIRED values below

# ══════════════════════════════════════════════════════════
# A 档 引导件 — 连库/连消息队列之前必需，唯一 env 来源
# ══════════════════════════════════════════════════════════

# Database password. Generate: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_24

# Database connection（compose 内网拓扑）
DB_NAME=ant
DB_USER=ant
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable

# Redis（DB 编号代码内固定 0）
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# NATS（NATS_USER/NATS_PASSWORD 仅作 compose 内 NATS_URL 插值）
NATS_URL=nats://nats:4222
NATS_USER=ant
NATS_PASSWORD=CHANGE_ME_NATS_PASSWORD

# ── Secrets / crypto 引导钥匙 ──
# AES-256-GCM master key (32 bytes, base64). Generate: openssl rand -base64 32
# 解密 platform_secrets / mt_accounts 凭据的 KEK——钥匙本身不能入库（自举悖论）。
ANT_MASTER_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# JWT 签名密钥（D 档秘密件，走 platform_secrets 密文轨；env 值仅首次 boot seed 用，
# 之后可从 .env 删除）。32+ chars. Generate: openssl rand -hex 24
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_24

# 其他可选引导件（有代码默认值，按需覆写）：
# PORT=8080 / SPILL_DIR=/var/lib/ant/spill / GEOIP_DB_PATH=... / ANT_KEY_DIR=...
# SENTRY_DSN / SENTRY_ENVIRONMENT / SENTRY_RELEASE / SENTRY_SAMPLE_RATE
# OTEL_EXPORTER_OTLP_ENDPOINT
# MTAPI_MT4_HOST / MTAPI_MT5_HOST（mtapi 网关服务发现，缺省空=用 brokersearch 默认）

# ══════════════════════════════════════════════════════════
# B 档 构建/部署期 — PG 救不了（前端 bake 与 compose 期变量），必须留 env
# ══════════════════════════════════════════════════════════

# Frontend host port（compose 端口映射）
ANT_FRONTEND_PORT=8022

# Frontend build args (Vite, only needed for Docker build / local npm run build)
# When unset, browser defaults to current page origin (same-origin reverse proxy).
VITE_MENU_MODE=full
NODE_BUILD_IMAGE=docker.io/library/node:22-alpine

# umami 统计侧容器 APP_SECRET（compose 期喂给 umami 容器；后端 Go 零读取——搬 PG 不生效）
UMAMI_APP_SECRET=CHANGE_ME_32_CHARS_MINIMUM_RANDOM_STRING

# ══════════════════════════════════════════════════════════
# 禁区例外 — 现有语义保留（ADR-0026 R5，xpub_audit.go）
# ══════════════════════════════════════════════════════════

# HD wallet deposit xpub fingerprint (R5 integrity anchor).
# Generated by hdgen alongside the xpub. Store in .env — NOT in DB（防替换锚：DB 被改也无法伪造指纹）。
DEPOSIT_XPUB_FINGERPRINT=
# DEPOSIT_XPUB 本体：DB（system_config deposit_xpub）优先、env 回退——已有语义，勿改。

# ══════════════════════════════════════════════════════════
# D 档 秘密件 seed 源 — 首次 boot 加密入 platform_secrets，之后可从 .env 删除
# ══════════════════════════════════════════════════════════

# TronGrid API key for USDT deposit chain monitoring (https://www.trongrid.io/)
TRONGRID_API_KEY=
# TronScan API key for multi-source verification (https://tronscan.org/)
TRONSCAN_API_KEY=

# ── SMTP (email notifications / password reset) ──
# Resend: smtp.resend.com:587, user=resend, pass=<API key>, from=support@alfq.org
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=support@alfq.org
SMTP_TO=admin@alfq.org

# mtapi 网关令牌（账户连接测试用，可空）
# MTAPI_TOKEN=

# ══════════════════════════════════════════════════════════
# C 档 业务旋钮 — 唯一真相源 system_config（管理面 SystemConfig 页可改）
# env 值仅首次 boot seed 用（缺键种入）；此后改这里不生效，改管理面或 DB 行。
# ══════════════════════════════════════════════════════════
# REQUIRE_KYC / REQUIRE_DISCLAIMER / REQUIRE_QUESTIONNAIRE / REQUIRE_EMAIL_VERIFICATION
# CHAIN_MONITOR_ENABLED / COOKIE_SECURE / RATE_LIMIT_ENABLED / RATE_LIMIT_LOGIN_PER_MINUTE
# APP_URL / WEBAUTHN_RP_ID / WEBAUTHN_RP_ORIGIN / TRONGRID_GRPC_ENDPOINT
# ALPHAFORGE_RISK_GATE_ENABLED / ALPHAFORGE_RISK_GATE_KILLSWITCH_DEFAULT / ALPHAFORGE_RISK_GATE_AUTOTRADE_DEFAULT
# AI_DAILY_MAX_SESSIONS / AI_DAILY_MAX_TOKENS / AI_DAILY_COST_LIMIT_USD / AI_MIN_BALANCE
#
# 示例（需要预置时取消注释）：
# REQUIRE_EMAIL_VERIFICATION=false
# CHAIN_MONITOR_ENABLED=true
