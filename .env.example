# Ant runtime env examples
# Duration values use Go ParseDuration format: 500ms, 5s, 1m
#
# Usage:
#   cp .env.example .env
#   # then fill REQUIRED values below
#   make env-check   # verify all required keys are set

# ══════════════════════════════════════════════════════════
# REQUIRED — container will refuse to start if unset/unchanged
# ══════════════════════════════════════════════════════════

# 32+ chars random string. Generate: openssl rand -hex 24
JWT_SECRET=CHANGE_ME_GENERATE_WITH_openssl_rand_hex_24

# Database password. Generate: openssl rand -base64 24
DB_PASSWORD=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_24

# ══════════════════════════════════════════════════════════
# OPTIONAL — sane defaults, override as needed
# ══════════════════════════════════════════════════════════

# ── Container naming / network ──
# Frontend host port (avoid 8012 if /opt/alphaforge is also running on this host)
ANT_FRONTEND_PORT=8022

# ── Database ──
DB_NAME=ant
DB_USER=ant
DB_HOST=postgres
DB_PORT=5432
DB_SSLMODE=disable

# ── Redis ──
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# ── External APIs ──
FMP_API_KEY=YOUR_FMP_API_KEY_HERE

# TronGrid API key for USDT deposit chain monitoring (https://www.trongrid.io/)
TRONGRID_API_KEY=
# TronScan API key for multi-source verification (https://tronscan.org/)
TRONSCAN_API_KEY=
# TronGrid gRPC endpoint for sweep transaction building/broadcasting (ADR-0026 Phase C)
TRONGRID_GRPC_ENDPOINT=grpc.trongrid.io:50051

# HD wallet deposit xpub fingerprint (ADR-0026 R5 integrity anchor).
# Generated by hdgen alongside the xpub. Store in .env — NOT in DB.
# If xpub is set via admin SystemConfig UI, this fingerprint verifies it at startup.
DEPOSIT_XPUB_FINGERPRINT=

# ── ClickHouse ──
CH_HOST=clickhouse
CH_PORT=9000
CH_USER=default
CH_PASSWORD=clickhouse
CH_DATABASE=ant

# ── Secrets ──
# AES-256-GCM master key (32 bytes, base64). Generate: openssl rand -base64 32
ANT_MASTER_KEY=CHANGE_ME_GENERATE_WITH_openssl_rand_base64_32

# ── NATS ──
NATS_URL=nats://nats:4222

# ── Frontend build args (Vite, only needed for Docker build / local npm run build) ──
# Production host direct-connect example:
# VITE_API_URL=http://43.255.29.23:8012
# VITE_STREAM_URL=http://43.255.29.23:8012
# When unset, browser defaults to current page origin (same-origin reverse proxy).
VITE_MENU_MODE=full
NODE_BUILD_IMAGE=docker.io/library/node:22-alpine

# ── SMTP (email notifications / password reset) ──
# Resend: smtp.resend.com:587, user=resend, pass=<API key>, from=support@alfq.org
SMTP_HOST=smtp.resend.com
SMTP_PORT=587
SMTP_USER=resend
SMTP_PASSWORD=
SMTP_FROM=support@alfq.org
SMTP_TO=admin@alfq.org
# Set to true after SMTP is configured and tested
REQUIRE_EMAIL_VERIFICATION=false

# ── Feature flags ──
# Seed default strategy templates on first start
ALPHAFORGE_SEED_DEFAULT_STRATEGY_TEMPLATES=true
# Enable MT/EA event-driven scheduler rollout (false: current behavior)
ALPHAFORGE_SCHEDULE_EVENT_DRIVEN_ENABLED=false

# ── Tuning ──
# Quote publish interval for stream worker aggregation flush
ALPHAFORGE_QUOTE_PUBLISH_INTERVAL=200ms
# Throttle window for quote worker warning logs
ALPHAFORGE_QUOTE_LOG_THROTTLE_WINDOW=12s
# Throttle window for schedule runner HF warning logs
ALPHAFORGE_SCHEDULE_LOG_THROTTLE_WINDOW=12s
# Low-frequency watchdog interval for schedule runtime fallback checks
ALPHAFORGE_SCHEDULE_WATCHDOG_INTERVAL=30s
# Throttle window for connection manager runtime warn/error logs
ALPHAFORGE_CONNECTION_LOG_THROTTLE_WINDOW=20s
