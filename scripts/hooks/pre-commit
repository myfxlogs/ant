#!/usr/bin/env bash
# 文档管理规则自动执行（2026-08-11 用户要求：规则靠机器强制，不靠人工提醒）
# 规则源：CLAUDE.md「无损接手铁律」+ docs/audits/builder-sop.md §2.6（2026-08-11 修订版）
# 适用：所有 agent（Claude Code / Windsurf / 任何接手 agent）——git 层强制，与提交者无关。
# 用法：无参 = 检查已暂存（pre-commit 钩子）；传 BASE_REF = 检查 BASE_REF...HEAD（CI 用）。
# 规则：① 变更日志条目（"- 20xx-..."）禁删/改 ② registry ✅ 行/状态标记行禁删。
# 例外（仅 ✅/⚠️ 完工明细行）：文件新版本仍含"靠 git 追溯"指针 = 文档化裁剪（用户批准的方式），放行。
# 🟦open/❓ 条目行：必留文件内（CLAUDE.md：open/返工中条目+根因+对抗测试记录必留），任何情况下禁删、无指针例外。
# 违规 = 提交被拦，改好文档再提交；禁止 --no-verify 绕过。

set -u
cd "$(git rev-parse --show-toplevel)" || exit 1
fail=0
base="${1:-}"

for f in docs/audits/handover-audit-plan.md docs/audits/tech-debt-registry.md; do
  if [ -n "$base" ]; then
    diff=$(git diff "$base...HEAD" -- "$f" 2>/dev/null) || continue
    new=$(git show "HEAD:$f" 2>/dev/null)
  else
    git diff --cached --quiet -- "$f" && continue
    diff=$(git diff --cached -- "$f")
    new=$(git show ":$f" 2>/dev/null)
  fi

  # 被删的文件行（排除 --- 头）：
  # ① 🟦open/❓ 状态行 = open/待核条目，必拦（无指针例外——open 条目必留文件内）
  #    例外：同一条目 ID 仍在新文件中且状态变为 ✅done/⚠️ = 合法状态变更，放行。
  deleted_open=$(echo "$diff" | grep '^-' | grep -v '^---' | grep -E '🟦open|❓')
  if [ -n "$deleted_open" ]; then
    # 提取被删行的条目 ID（| 分割的第一列），检查该 ID 是否仍存在于新文件中
    truly_deleted=""
    while IFS= read -r line; do
      id=$(echo "$line" | sed 's/^-|//' | sed 's/ |.*//' | tr -d ' ')
      if [ -n "$id" ] && ! echo "$new" | grep -q "^| $id |"; then
        truly_deleted="$truly_deleted\n  $id"
      fi
    done <<< "$deleted_open"
    if [ -n "$truly_deleted" ]; then
      echo "❌ 文档规则：$f 删除了 open/待核条目行（🟦open/❓）。open 条目必留文件内（根因+对抗记录），无例外——恢复该行再提交。" >&2
      echo -e "   被真正删除的条目 ID：$truly_deleted" >&2
      fail=1
    fi
  fi
  # ② 变更日志条目 / ✅ / ⚠️ 行 = 完工明细，仅"文件保留'靠 git 追溯'指针"时允许归档裁剪
  deleted_done=$(echo "$diff" | grep '^-' | grep -v '^---' | grep -E '^- 20[0-9]{2}-|✅|⚠️')
  if [ -n "$deleted_done" ]; then
    if ! echo "$new" | grep -q '追溯'; then
      echo "❌ 文档规则：$f 删除了完工/状态记录（变更日志条目 / ✅ 行）。" >&2
      echo "   → 无意删除：恢复该行再提交；有意裁剪：文件必须保留"靠 git 追溯"指针行（用户批准的方式）。" >&2
      fail=1
    fi
  fi
done

exit $fail
