agent_default_name: 'Agent tùy chỉnh'
agent_defaults_code_input_hint: 'Ví dụ: trend-following EMA(fast)/EMA(slow) với bộ lọc ATR; params = fast, slow, atr_period, risk_per_trade.'
agent_defaults_execution_input_hint: 'Ví dụ: mua 10 lot EURUSD; spread = 0,6 pip; mục tiêu 5 phút; trượt giá tối đa = 0,8 pip.'
agent_defaults_executor_identity: 'Chuyên gia tối ưu hóa thực thi giao dịch — giảm thiểu trượt giá và chi phí thực thi.'
agent_defaults_macro_input_hint: 'Ví dụ: sự kiện chính = CPI Mỹ và biên bản FOMC; mã mục tiêu = XAUUSD.'
agent_defaults_portfolio_input_hint: 'Ví dụ: chiến lược = trend-EURUSD và mean-reversion-XAUUSD; vốn = 50.000; vol mục tiêu = 12% năm.'
agent_defaults_researcher_identity: 'Nhà nghiên cứu kinh tế vĩ mô và ngành — phân tích sự kiện vĩ mô và xu hướng ngành.'
agent_defaults_risk_input_hint: 'Ví dụ: vốn = 10.000; giới hạn drawdown tháng = 5%; rủi ro mỗi giao dịch = 0,5%; giao dịch trong ngày <= 5; cắt lỗ = 1,5×ATR.'
agent_defaults_risk_manager_identity: 'Chuyên gia kiểm soát rủi ro nghiêm ngặt — thiết kế quy mô vị thế, cắt lỗ, giới hạn sụt giảm.'
agent_defaults_sentiment_input_hint: 'Ví dụ: VIX từ 14 lên 22; vị thế long ròng phi thương mại -18%; tin tức chủ đạo về suy thoái / cắt giảm lãi suất.'
agent_defaults_signals_input_hint: 'Ví dụ: mô hình = trend-following; khung thời gian = H1; chỉ báo = EMA/ATR/ADX; fast = 20, slow = 60.'
agent_defaults_strategist_identity: 'Chuyên viên phân tích chiến lược định lượng cấp cao — đề xuất mô hình chiến lược dựa trên điều kiện tài khoản/thị trường.'
agent_defaults_style_input_hint: 'Ví dụ: tài khoản = EURUSD cá nhân; khung thời gian = H1; mục tiêu = lợi nhuận 3%/tháng, drawdown tối đa <10%; ưu tiên = tỷ lệ thắng hơn tỷ lệ lời/lỗ.'
