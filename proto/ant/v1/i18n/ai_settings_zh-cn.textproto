agent_defaults_code_input_hint: '示例：目标范式=趋势跟随；指标=EMA(fast)/EMA(slow)+ATR 过滤；参数=fast,slow,atr_period,risk_per_trade。'
agent_defaults_execution_input_hint: '示例：订单=做多 EURUSD 10 手；当前点差=0.6 pip；目标 5 分钟内完成；可接受滑点=0.8 pip。'
