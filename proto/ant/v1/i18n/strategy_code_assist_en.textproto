optional_params_desc: 'These parameters already have defaults from the code. Leave a field blank to use the default; entering a value only applies to this run and does not modify the saved strategy.'
optional_params_title: 'Optional parameters'
param_descriptions_confidence: 'Signal confidence threshold (0-1). Signals below this value are ignored.'
param_descriptions_ema_period: 'EMA (exponential moving average) lookback in bars.'
param_descriptions_fast_period: 'Fast period (number of bars). Used by MACD / dual-MA; smaller is more reactive.'
param_descriptions_generic_percent: 'Percentage / ratio parameter (e.g. 1 means 1%).'
param_descriptions_generic_period: 'Lookback window in bars used for indicator calculation.'
param_descriptions_lot_size: 'Order size (lots / volume). Larger size means more risk.'
param_descriptions_max_loss: 'Max loss per trade as a fraction of equity (0.01 = 1%).'
param_descriptions_risk_level: 'Risk level (low / medium / high). Controls position size and stop/take-profit width.'
param_descriptions_rsi_period: 'RSI lookback (number of bars). Typical value: 14.'
param_descriptions_signal_period: 'Signal period (number of bars). Smoothing length for MACD DIF/DEA.'
param_descriptions_slow_period: 'Slow period (number of bars). Used by MACD / dual-MA; larger is smoother.'
param_descriptions_sma_period: 'SMA (simple moving average) lookback in bars.'
param_descriptions_stop_loss: 'Stop-loss distance (%). Close the position once price moves this far against you.'
param_descriptions_take_profit: 'Take-profit distance (%). Close the position once price moves this far in your favour.'
param_descriptions_threshold: 'Threshold that triggers a signal. Exact meaning depends on the strategy logic.'
required: 'required'
required_params_desc: 'The strategy reads these parameters but no default was provided. Fill them in before saving.'
required_params_title: 'Required parameters'
revise_input_placeholder: 'e.g. Replace SMA(20) with EMA(50) and add a 1% stop-loss.'
