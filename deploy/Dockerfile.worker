# Strategy Worker — OS-level sandbox (T3.3 / D5)
#
# Multi-stage: 安装依赖 → 复制代码 → 应用 seccomp
# 运行用户: nobody (65534)
# Python: 完整环境 (numpy/pandas 可用 — 安全由内核保证)

FROM python:3.12-slim AS builder

WORKDIR /app

# 安装编译依赖 (numpy/pandas 的 C 扩展需要)
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc g++ libc-dev && \
    rm -rf /var/lib/apt/lists/*

COPY strategy-service/requirements.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# ── Runtime stage ────────────────────────────────────────────────
FROM python:3.12-slim

WORKDIR /app

# 安装运行时依赖
RUN apt-get update && apt-get install -y --no-install-recommends \
    libstdc++6 procps && \
    rm -rf /var/lib/apt/lists/* && \
    mkdir -p /tmp && chmod 1777 /tmp

# 从 builder 复制 Python 包
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages

# 复制策略服务代码 (paths relative to repo root)
COPY strategy-service/app /app/app
COPY strategy-service/tests /app/tests

# 应用 seccomp profile（Python 模块在启动时通过 sandbox_os.apply_seccomp() 应用）
COPY deploy/sandbox/seccomp_profile.json /app/seccomp_profile.json

# 注意: 构建上下文为 repo root (context: .)，
# 因此 COPY 路径相对于 /opt/ant/ 根目录

# 切换到非 root (nobody 用户预装于 python:3.12-slim)
USER nobody

ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/app:/app/app

HEALTHCHECK --interval=10s --timeout=5s --retries=3 \
    CMD python3 -c "from app.main import app; print('ok')" || exit 1

CMD ["python3", "-m", "app.main"]
