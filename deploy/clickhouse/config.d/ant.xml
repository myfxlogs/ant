<clickhouse>
    <listen_host>0.0.0.0</listen_host>
    <max_connections>64</max_connections>
    <max_concurrent_queries>8</max_concurrent_queries>
    <max_table_size_to_drop>0</max_table_size_to_drop>

    <!-- Disable heavy system log tables (not needed at 3-account scale) -->
    <text_log><enabled>false</enabled></text_log>
    <metric_log><enabled>false</enabled></metric_log>
    <trace_log><enabled>false</enabled></trace_log>
    <processors_profile_log><enabled>false</enabled></processors_profile_log>
    <asynchronous_metric_log><enabled>false</enabled></asynchronous_metric_log>
    <part_log><enabled>false</enabled></part_log>

    <!-- Keep query_log for debugging but limit retention -->
    <query_log>
        <enabled>true</enabled>
        <ttl>event_date + INTERVAL 3 DAY DELETE</ttl>
    </query_log>

    <!-- Memory governance: 2GiB container × 0.85 = 1.7GiB for ClickHouse, 300MiB for OS/kernel -->
    <max_server_memory_usage_to_ram_ratio>0.85</max_server_memory_usage_to_ram_ratio>

    <!-- Cap caches so they don't squeeze query memory -->
    <mark_cache_size>134217728</mark_cache_size>          <!-- 128 MiB -->
    <uncompressed_cache_size>268435456</uncompressed_cache_size>  <!-- 256 MiB -->

    <merge_tree>
        <max_suspicious_broken_parts>10</max_suspicious_broken_parts>
    </merge_tree>
</clickhouse>
